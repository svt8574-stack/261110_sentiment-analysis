# ==========================================
# [ONDO] 환경 변수 템플릿 (.env.example)
# ==========================================

# 1. OpenAI API 설정
# OpenAI 대시보드(https://platform.openai.com/api-keys)에서 발급받은 API 키를 입력하세요.
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 OpenAI 모델명 (기본 권장: gpt-4o-mini 또는 gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# 2. Supabase 데이터베이스 설정
# Supabase 프로젝트 대시보드 -> Project Settings -> API 에서 확인 가능합니다.
# Project URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Project API Keys -> service_role secret (서버리스 함수 전용 비공개 키)
# 주의: 절대 브라우저나 외부에 노출되면 안 되는 관리자 키입니다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

